  + (sumBy t.members fun p => p.coreP1.qualifiedAdoptionAssistanceExpense)
  + (sumBy t.members fun p => p.coreP2.usBondsForHigherEd)
  + t.irs.specifiedPossessionIncome
  + t.irs.puertoRicoIncome) else (if Date.ble ⟨2018, 1, 1⟩ d then (t.irs.lossAld
  + (selfEmploymentTaxAld t d)
  + (sumBy t.members fun p => p.irs.studentLoanInterestAld)
  + (sumBy t.members fun p => p.coreP1.earlyWithdrawalPenalty)
  + (alimonyExpenseAld t d)
  + (sumBy t.members fun p => p.coreP1.educatorExpense)
  + t.irs.cappedQualifiedTuitionExpensesAld
  + t.irs.healthSavingsAccountAld
  + (selfEmployedHealthInsuranceAld t d)
  + (selfEmployedPensionContributionAld t d)
  + (sumBy t.members fun p => p.coreP2.traditionalIraContributions)
  + (sumBy t.members fun p => p.coreP1.qualifiedAdoptionAssistanceExpense)
  + (sumBy t.members fun p => p.coreP2.usBondsForHigherEd)
  + t.irs.specifiedPossessionIncome
  + t.irs.puertoRicoIncome) else (t.irs.lossAld
  + (selfEmploymentTaxAld t d)
  + (sumBy t.members fun p => p.irs.studentLoanInterestAld)
  + (sumBy t.members fun p => p.coreP1.earlyWithdrawalPenalty)
  + (alimonyExpenseAld t d)
  + (sumBy t.members fun p => p.coreP1.educatorExpense)
  + t.irs.cappedQualifiedTuitionExpensesAld
  + t.irs.domesticProductionAld
  + t.irs.healthSavingsAccountAld
  + (selfEmployedHealthInsuranceAld t d)
  + (selfEmployedPensionContributionAld t d)
  + (sumBy t.members fun p => p.coreP2.traditionalIraContributions)
  + (sumBy t.members fun p => p.coreP1.qualifiedAdoptionAssistanceExpense)
  + (sumBy t.members fun p => p.coreP2.usBondsForHigherEd)
  + t.irs.specifiedPossessionIncome
