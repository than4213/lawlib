/-- `policyengine_us/variables/gov/irs/credits/ctc/refundable/ctc_social_security_tax.py`
    policyengine-us 1.783.0, entity tax_unit, value_type float. -/
def ctcSocialSecurityTax (t : TaxUnit) (d : Date) : Rat :=
  (((sumBy t.members fun p => (employeeSocialSecurityTax t p d))
  + (sumBy t.members fun p => (employeeMedicareTax t p d))
  + t.irs.unreportedPayrollTax
  + (selfEmploymentTaxAld t d)
  + (additionalMedicareTax t d)) - t.irs.excessPayrollTaxWithheld)

