def pellGrantEligibilityType (t : TaxUnit) (p : Person) (d : Date) : PellGrantEligibilityType :=
  let fpg_percent := ((adjustedGrossIncome t d) / t.hhs.taxUnitFpg);
  (if (decide (fpg_percent ≤ (pellGrantMaxFpgPercentLimit t p d))) then
      PellGrantEligibilityType.MAXIMUM else (if
      (decide (fpg_percent ≤ (pellGrantMinFpgPercentLimit t p d))) then
      PellGrantEligibilityType.MINIMUM else PellGrantEligibilityType.INELIGIBLE))

end Lawlib.USA
