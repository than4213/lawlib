/-- `policyengine_us/variables/household/demographic/person/has_disabled_spouse.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def hasDisabledSpouse (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  ((t.core.filingStatus == FilingStatus.JOINT) &&
      ((p.coreP1.isTaxUnitHead && (spouseIsDisabled t d)) ||
      (p.coreP1.isTaxUnitSpouse && (headIsDisabled t d))))

/-- `policyengine_us/variables/household/demographic/tax_unit/is_child_of_tax_head.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isChildOfTaxHead (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (isChild t p d)

/-- `policyengine_us/variables/household/demographic/person/is_father.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isFather (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  ((!p.coreP1.isFemale) && (isParent t p d))

/-- `policyengine_us/variables/household/demographic/person/is_full_time_student.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isFullTimeStudent (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (p.coreP1.isFullTimeCollegeStudent || (isInK12School t p d))

/-- `policyengine_us/variables/household/demographic/person/is_mother.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isMother (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (p.coreP1.isBreastfeeding || (p.coreP1.isFemale && (isParent t p d)))

/-- `policyengine_us/variables/household/demographic/age/is_wa_adult.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isWaAdult (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  ((!(isChild t p d)) && (!(isSenior t p d)))

/-- `policyengine_us/reforms/states/mi/surtax.py`
    policyengine-us 1.783.0, entity tax_unit, value_type float. -/
def miIncomeTax (t : TaxUnit) (d : Date) : Rat :=
  (if (MI t d) then ((t.statesMi.miIncomeTaxBeforeRefundableCredits + t.core.miSurtax) -
      t.statesMi.miRefundableCredits) else 0)

/-- `policyengine_us/variables/household/demographic/spm_unit/spm_unit_count_children.py`
    policyengine-us 1.783.0, entity spm_unit, value_type int. -/
def spmUnitCountChildren (t : TaxUnit) (d : Date) : Rat :=
  (sumBy t.members fun p => boolToRat (isChild t p d))

/-- `policyengine_us/variables/household/demographic/tax_unit/tax_unit_children.py`
    policyengine-us 1.783.0, entity tax_unit, value_type float. -/
def taxUnitChildren (t : TaxUnit) (d : Date) : Rat :=
  (sumBy t.members fun p => boolToRat (isChild t p d))

/-- `policyengine_us/variables/household/demographic/tax_unit/tax_unit_dependents.py`
    policyengine-us 1.783.0, entity tax_unit, value_type int. -/
def taxUnitDependents (t : TaxUnit) (d : Date) : Rat :=
  (sumBy t.members fun p => boolToRat (isTaxUnitDependent t p d))

/-- `policyengine_us/variables/household/demographic/tax_unit/taxpayer_has_tin.py`
    policyengine-us 1.783.0, entity tax_unit, value_type bool. -/
def taxpayerHasTin (t : TaxUnit) (d : Date) : Bool :=
  (anyBy t.members fun p => ((isTaxUnitHeadOrSpouse t p d) && p.coreP1.hasTin))

/-- `policyengine_us/variables/household/demographic/age/age_group.py`
    policyengine-us 1.783.0, entity person, value_type Enum. -/
def ageGroup (t : TaxUnit) (p : Person) (d : Date) : AgeGroup :=
  (if (isChild t p d) then AgeGroup.CHILD else (if (isWaAdult t p d) then
      AgeGroup.WORKING_AGE else
      (if (isSenior t p d) then AgeGroup.SENIOR else AgeGroup.CHILD)))

/-- `policyengine_us/variables/household/demographic/person/is_qualifying_child_dependent.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isQualifyingChildDependent (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (if (isTaxUnitDependent t p d) then (decide (p.coreP1.age < (if (isFullTimeStudent t p d)
      then (gov.irs.dependent.ineligible_age.student.atDate d) else
      (gov.irs.dependent.ineligible_age.non_student.atDate d)))) else false)

/-- `policyengine_us/variables/household/demographic/tax_unit/taxpayer_has_itin.py`
    policyengine-us 1.783.0, entity tax_unit, value_type bool. -/
def taxpayerHasItin (t : TaxUnit) (d : Date) : Bool :=
  (taxpayerHasTin t d)

/-- `policyengine_us/variables/household/demographic/person/is_child_dependent.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isChildDependent (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (if (isTaxUnitDependent t p d) then
      (((isQualifyingChildDependent t p d) || p.coreP1.isQualifyingRelativeDependent) ||
      p.coreP1.isPermanentlyAndTotallyDisabled) else false)

/-- `policyengine_us/variables/household/demographic/tax_unit/tax_unit_child_dependents.py`
    policyengine-us 1.783.0, entity tax_unit, value_type int. -/
def taxUnitChildDependents (t : TaxUnit) (d : Date) : Rat :=
  (sumBy t.members fun p => boolToRat (isChildDependent t p d))

/-- `policyengine_us/variables/household/demographic/tax_unit/surviving_spouse_eligible.py`
    policyengine-us 1.783.0, entity tax_unit, value_type bool. -/
def survivingSpouseEligible (t : TaxUnit) (d : Date) : Bool :=
  (((anyBy t.members fun p => (p.coreP1.isTaxUnitHead && p.coreP1.isSurvivingSpouse)) &&
      (decide ((taxUnitChildDependents t d) > 0))) && (!(taxUnitMarried t d)))

/-- `policyengine_us/variables/household/demographic/tax_unit/head_of_household_eligible.py`
    policyengine-us 1.783.0, entity tax_unit, value_type bool. -/
def headOfHouseholdEligible (t : TaxUnit) (d : Date) : Bool :=
  let is_separated := (anyBy t.members fun p => ((isTaxUnitHeadOrSpouse t p d) &&
      p.coreP1.isSeparated));
  (((((decide ((sumBy t.members fun p => (boolToRat (((isQualifyingChildDependent t p d) ||
      (p.coreP1.isPermanentlyAndTotallyDisabled && (isTaxUnitDependent t p d))) ||
      (p.coreP1.isQualifyingRelativeDependent && p.coreP1.isRelatedToHeadOrSpouse)))) > 0))
      && (!(taxUnitMarried t d))) && (!is_separated)) || (((decide ((sumBy t.members fun p
      => (boolToRat (isQualifyingChildDependent t p d))) > 0)) && is_separated) &&
      (!(taxUnitMarried t d)))) && (!(survivingSpouseEligible t d)))

end Lawlib.USA
