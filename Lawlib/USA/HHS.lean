/-- `policyengine_us/variables/gov/hhs/ccdf/ccdf_age_group.py`
    policyengine-us 1.783.0, entity person, value_type Enum. -/
def ccdfAgeGroup (t : TaxUnit) (p : Person) (d : Date) : CCDFAgeGroup :=
  (if (((decide (p.coreP1.age < (mkRat 3 2))) && (!(isCcdfHomeBased t p d))) || ((decide
      (p.coreP1.age < 2)) && (isCcdfHomeBased t p d))) then CCDFAgeGroup.INFANT else (if
      (((decide (p.coreP1.age < 2)) && (!(isCcdfHomeBased t p d))) ||
      ((decide (p.coreP1.age < 3)) && (isCcdfHomeBased t p d))) then CCDFAgeGroup.TODDLER
      else (if (decide (p.coreP1.age < 6)) then CCDFAgeGroup.PRESCHOOLER else (if
      (decide (p.coreP1.age < 13)) then CCDFAgeGroup.SCHOOL_AGE else CCDFAgeGroup.INFANT))))

/-- `policyengine_us/variables/gov/hhs/ccdf/ccdf_income_to_smi_ratio.py`
    policyengine-us 1.783.0, entity spm_unit, value_type float. -/
def ccdfIncomeToSmiRatio (t : TaxUnit) (d : Date) : Rat :=
