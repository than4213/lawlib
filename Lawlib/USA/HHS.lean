    policyengine-us 1.783.0, entity person, value_type float. -/
def medicaidCost (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (medicaidEnrolled t p d) then p.hhs.medicaidCostIfEnrolled else 0)

/-- `policyengine_us/variables/gov/hhs/medicare/costs/medicare_enrolled.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def medicareEnrolled (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (if (isMedicareEligible t p d) then (decide
      (boolToRat p.hhs.takesUpMedicareIfEligible ≠ 0)) else false)

/-- `policyengine_us/variables/gov/hhs/tanf/cash/tanf.py`
    policyengine-us 1.783.0, entity spm_unit, value_type float. -/
def tanf (t : TaxUnit) (d : Date) : Rat :=
  (if t.hhs.takesUpTanfIfEligible then (tanfIfTakesUp t d) else 0)

/-- `policyengine_us/variables/gov/hhs/medicare/eligibility/part_a/base_part_a_premium.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def basePartAPremium (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (isMedicareEligible t p d) then ((if (isPremiumFreePartA t p d) then 0 else (if
      (decide (p.hhs.medicareQuartersOfCoverage ≥
      (gov.hhs.medicare.part_a.reduced_premium_quarters_threshold.atDate d))) then
      (gov.hhs.medicare.part_a.reduced_premium.atDate d) else
      (gov.hhs.medicare.part_a.full_premium.atDate d))) * 12) else 0)

/-- `policyengine_us/variables/gov/hhs/chip/chip_enrolled.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def chipEnrolled (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (if (isChipEligible t p d) then (decide (boolToRat p.hhs.takesUpChipIfEligible ≠ 0)) else
      false)

/-- `policyengine_us/variables/gov/hhs/chip/chip_gross.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def chipGross (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (isChipEligible t p d) then p.hhs.perCapitaChipGross else 0)

/-- `gross_medicare_part_b_premium_if_enrolled.py`
    in `policyengine_us/variables/gov/hhs/medicare/eligibility/part_b/`
    policyengine-us 1.783.0, entity person, value_type float. -/
def grossMedicarePartBPremiumIfEnrolled (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (medicareEnrolled t p d) then p.hhs.grossMedicarePartBPremium else 0)

/-- `policyengine_us/variables/gov/hhs/chip/has_chip_disqualifying_health_coverage.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def hasChipDisqualifyingHealthCoverage (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (decide ((boolToRat p.coreP1.hasHealthCoverageOtherThanChip
  + boolToRat p.aca.hasEsi
  + boolToRat (medicaidEnrolled t p d)
  + boolToRat p.hhs.receivesMedicaid
  + boolToRat p.coreP1.hasMedicaidHealthCoverageAtInterview
  + boolToRat (medicareEnrolled t p d)
  + boolToRat p.coreP1.hasMarketplaceHealthCoverageAtInterview
  + boolToRat p.coreP1.hasNonMarketplaceDirectPurchaseHealthCoverageAtInterview
  + boolToRat p.coreP1.hasOtherMeansTestedHealthCoverageAtInterview
  + boolToRat p.coreP1.hasTricareHealthCoverageAtInterview
  + boolToRat p.coreP1.hasChampvaHealthCoverageAtInterview
  + boolToRat p.coreP1.hasVaHealthCoverageAtInterview) > 0))

/-- `policyengine_us/variables/gov/hhs/ccdf/is_ccdf_income_eligible.py`
    policyengine-us 1.783.0, entity spm_unit, value_type bool. -/
def isCcdfIncomeEligible (t : TaxUnit) (d : Date) : Bool :=
  (decide ((ccdfIncomeToSmiRatio t d) ≤ (gov.hhs.ccdf.income_limit_smi.atDate d)))

/-- `is_medicaid_long_term_care_eligible.py`
    in `policyengine_us/variables/gov/hhs/medicaid/eligibility/`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isMedicaidLongTermCareEligible (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  ((p.hhs.isMedicaidEligible && (receivesMedicaidLongTermCareServices t p d)) &&
      (isMedicaidLongTermCareHomeEquityEligible t p d))

/-- `policyengine_us/variables/gov/hhs/medicaid/medicaid.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def medicaid (t : TaxUnit) (p : Person) (d : Date) : Rat :=
