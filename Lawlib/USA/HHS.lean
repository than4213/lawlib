      (boolToRat (isAdultForMedicaidNfc t p d) > 0)))

/-- `policyengine_us/variables/gov/hhs/chip/is_chip_eligible.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isChipEligible (t : TaxUnit) (p : Person) (d : Date) : Bool :=
