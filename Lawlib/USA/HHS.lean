/-- `policyengine_us/variables/gov/hhs/medicaid/costs/medicaid_federal_cost.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def medicaidFederalCost (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (medicaidEnrolled t p d) then ((medicaidCost t p d) * p.hhs.medicaidFederalShare) else
      0)

/-- `policyengine_us/variables/gov/hhs/medicaid/costs/medicaid_state_cost.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def medicaidStateCost (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (medicaidEnrolled t p d) then ((medicaidCost t p d) *
      (1 - p.hhs.medicaidFederalShare)) else 0)

/-- `policyengine_us/variables/gov/hhs/medicare/eligibility/part_b/medicare_part_b_premium.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def medicarePartBPremium (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (medicareEnrolled t p d) then (max
      ((p.hhs.grossMedicarePartBPremium - p.hhs.mspPartBPremiumCoverage) : Rat) 0) else 0)

/-- `policyengine_us/variables/gov/hhs/chip/chip.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def chip (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (chipEnrolled t p d) then p.hhs.perCapitaChip else 0)

/-- `policyengine_us/variables/gov/hhs/ccdf/is_ccdf_eligible.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isCcdfEligible (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  ((((isCcdfAssetEligible t d) && (isCcdfAgeEligible t p d)) && (isCcdfIncomeEligible t d))
      && (isCcdfReasonForCareEligible t p d))

/-- `policyengine_us/variables/gov/hhs/medicare/eligibility/part_a/medicare_part_a_premium.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def medicarePartAPremium (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (medicareEnrolled t p d) then (max
      (((basePartAPremium t p d) - p.hhs.mspPartAPremiumCoverage) : Rat) 0) else 0)

/-- `policyengine_us/variables/gov/hhs/chip/chip_federal_cost.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def chipFederalCost (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (chipEnrolled t p d) then ((chip t p d) * p.hhs.chipFederalShare) else 0)

/-- `policyengine_us/variables/gov/hhs/chip/chip_state_cost.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def chipStateCost (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (chipEnrolled t p d) then ((chip t p d) * (1 - p.hhs.chipFederalShare)) else 0)

/-- `policyengine_us/variables/gov/hhs/ccdf/spm_unit_ccdf_subsidy.py`
    policyengine-us 1.783.0, entity spm_unit, value_type float. -/
def spmUnitCcdfSubsidy (t : TaxUnit) (d : Date) : Rat :=
  (max (((sumBy t.members fun p =>
      (p.hhs.ccdfMarketRate * (boolToRat (isCcdfEligible t p d)))) -
      t.hhs.spmUnitTotalCcdfCopay) : Rat) 0)

