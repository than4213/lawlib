      WICFoodPackage.PREGNANT_SINGLETON else (if ((breastfeeding &&
      p.usda.isWicFullyBreastfeeding) && (decide (p.usda.wicBreastfeedingInfantCount ≥ 2)))
      then WICFoodPackage.FULLY_BREASTFEEDING_MULTIPLES else (if (breastfeeding &&
      (p.usda.isWicFullyBreastfeeding || (decide (p.usda.wicBreastfeedingInfantCount ≥ 2))))
      then WICFoodPackage.FULLY_BREASTFEEDING else (if breastfeeding then
      WICFoodPackage.PARTIALLY_BREASTFEEDING else (if (p.usda.wicCategory ==
      WICCategory.POSTPARTUM) then WICFoodPackage.POSTPARTUM_NON_BREASTFEEDING else (if
      (infant && (p.usda.wicInfantFeedingCategory == WICInfantFeedingCategory.AVERAGE)) then
      WICFoodPackage.INFANT_AVERAGE else (if ((infant && (decide (age_months < 4))) &&
      fully_formula_fed) then WICFoodPackage.INFANT_0_3_FULLY_FORMULA_FED else (if ((infant
      && (decide (age_months < 6))) && fully_formula_fed) then
      WICFoodPackage.INFANT_4_5_FULLY_FORMULA_FED else (if ((infant && (decide (age_months <
      4))) && partially_breastfed) then WICFoodPackage.INFANT_0_3_PARTIALLY_BREASTFED else
      (if ((infant && (decide (age_months < 6))) && partially_breastfed) then
      WICFoodPackage.INFANT_4_5_PARTIALLY_BREASTFED else (if (infant && partially_breastfed)
      then WICFoodPackage.INFANT_6_11_PARTIALLY_BREASTFED else (if ((infant && (decide
      (age_months < 6))) && fully_breastfed) then WICFoodPackage.INFANT_0_5_FULLY_BREASTFED
      else (if (infant && fully_formula_fed) then
      WICFoodPackage.INFANT_6_11_FULLY_FORMULA_FED else (if (infant && fully_breastfed) then
      WICFoodPackage.INFANT_6_11_FULLY_BREASTFED else (if (child && (decide (p.coreP1.age <
      2))) then WICFoodPackage.CHILD_12_23_MONTHS else (if child then
      WICFoodPackage.CHILD_24_59_MONTHS else WICFoodPackage.NONE))))))))))))))))))

/-- `policyengine_us/variables/gov/usda/has_all_usda_elderly_disabled.py`
    policyengine-us 1.783.0, entity spm_unit, value_type bool. -/
def hasAllUsdaElderlyDisabled (t : TaxUnit) (d : Date) : Bool :=
  (allBy t.members fun p => ((isUsdaElderly t p d) || p.usda.isUsdaDisabled))

/-- `policyengine_us/variables/gov/usda/has_usda_elderly_disabled.py`
    policyengine-us 1.783.0, entity spm_unit, value_type bool. -/
def hasUsdaElderlyDisabled (t : TaxUnit) (d : Date) : Bool :=
  (anyBy t.members fun p => ((isUsdaElderly t p d) || p.usda.isUsdaDisabled))

/-- `policyengine_us/variables/gov/usda/snap/eligibility/student/is_snap_ineligible_student.py`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isSnapIneligibleStudent (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (if (isSnapHigherEdStudent t p d) then (!((((((decide
      ((gov.usda.snap.student.age_threshold.atDate d p.coreP1.age) ≠ 0)) ||
      p.coreP1.isDisabled) || (isSnapEmploymentTrainingOrWorkIncentiveStudent t p d)) ||
      (meetsSnapWorkException t p d)) || p.usda.meetsSnapParentException) || ((decide
      (p.hhs.tanfPerson > 0)) || (decide (boolToRat t.hhs.receivesTanf > 0))))) else false)

/-- `policyengine_us/variables/gov/usda/snap/income/snap_earned_income_person.py`
    policyengine-us 1.783.0, entity person, value_type float. -/
def snapEarnedIncomePerson (t : TaxUnit) (p : Person) (d : Date) : Rat :=
  (if (snapCountableEarner t p d) then (p.coreP1.employmentIncome / 12) else 0)

/-- `is_snap_state_discretion_ineligible_alien.py`
    in `policyengine_us/variables/gov/usda/snap/income/ineligible_members/`
    policyengine-us 1.783.0, entity person, value_type bool. -/
def isSnapStateDiscretionIneligibleAlien (t : TaxUnit) (p : Person) (d : Date) : Bool :=
  (((!(isSnapIneligibleStudent t p d)) && (!(isSnapImmigrationStatusEligible t p d))) &&
      ((gov.usda.snap.income.ineligible_members.pre_prwora_statuses.atDate d).contains
      (ImmigrationStatus.asStr p.coreP1.immigrationStatus)))

