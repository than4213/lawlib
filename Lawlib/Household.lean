    hud := (j.getObjValAs? TaxUnit_Hud "hud").toOption.getD {},
    irs := (j.getObjValAs? TaxUnit_Irs "irs").toOption.getD {},
    localCa := (j.getObjValAs? TaxUnit_Local_ca "local_ca").toOption.getD {},
    localTax := (j.getObjValAs? TaxUnit_Local_tax "local_tax").toOption.getD {},
    statesDc := (j.getObjValAs? TaxUnit_States_dc "states_dc").toOption.getD {},
    statesMt := (j.getObjValAs? TaxUnit_States_mt "states_mt").toOption.getD {},
    statesTax := (j.getObjValAs? TaxUnit_States_tax "states_tax").toOption.getD {},
    usda := (j.getObjValAs? TaxUnit_Usda "usda").toOption.getD {} }

