let scope EarnedIncomeCredit
  (earned_income_credit_in: EarnedIncomeCredit_in)
  : EarnedIncomeCredit
  =
  let get earned_income : money = earned_income_credit_in.earned_income_in in
  let get adjusted_gross_income : money =
    earned_income_credit_in.adjusted_gross_income_in
  in
  let get qualifying_children : integer =
    earned_income_credit_in.qualifying_children_in
  in
  let get joint_return : bool = earned_income_credit_in.joint_return_in in
  let set credit_percentage : optional of (decimal, code_location) =
    Present
      (if qualifying_children = 0 then 0.0765
       else if qualifying_children = 1 then 0.34
       else if qualifying_children = 2 then 0.4
       else 0.45, <section_32:94.5-97.13>)
  in
  let set phaseout_percentage : optional of (decimal, code_location) =
    Present
      (if qualifying_children = 0 then 0.0765
       else if qualifying_children = 1 then 0.1598
       else 0.2106, <section_32:100.5-102.16>)
  in
  let set earned_income_amount : optional of (money, code_location) =
    Present
      (if qualifying_children = 0 then ¤7840.00
       else if qualifying_children = 1 then ¤11750.00
       else ¤16510.00, <section_32:115.5-117.17>)
  in
  let set phaseout_amount : optional of (money, code_location) =
    Present
      (if joint_return then
         if qualifying_children = 0 then ¤16370.00 else ¤28120.00
       else if qualifying_children = 0 then ¤9800.00
       else ¤21560.00, <section_32:120.5-123.60>)
  in
  let set credit_before_limitation : optional of (money, code_location) =
    Present
      (if
         earned_income
         ≥ match earned_income_amount with
           | Absent → error NoValue
           | Present arg → arg.0
       then
         match earned_income_amount with
         | Absent → error NoValue
         | Present arg → arg.0
       else earned_income
       * match credit_percentage with
         | Absent → error NoValue
         | Present arg → arg.0, <section_32:44.5-47.29>)
  in
  let set income_over_phaseout : optional of (money, code_location) =
    Present
      (if adjusted_gross_income ≥ earned_income then
         if
           adjusted_gross_income
           ≥ match phaseout_amount with
             | Absent → error NoValue
             | Present arg → arg.0
         then
           adjusted_gross_income
           - match phaseout_amount with
             | Absent → error NoValue
             | Present arg → arg.0
         else ¤0.00
       else if
         earned_income
         ≥ match phaseout_amount with
           | Absent → error NoValue
           | Present arg → arg.0
       then
         earned_income
         - match phaseout_amount with
           | Absent → error NoValue
           | Present arg → arg.0
       else ¤0.00, <section_32:62.5-69.16>)
  in
  let set limitation : optional of (money, code_location) =
    Present
      (if
         (match earned_income_amount with
          | Absent → error NoValue
          | Present arg → arg.0)
         * match credit_percentage with
           | Absent → error NoValue
           | Present arg → arg.0
         ≥ (match income_over_phaseout with
            | Absent → error NoValue
            | Present arg → arg.0)
           * match phaseout_percentage with
             | Absent → error NoValue
             | Present arg → arg.0
       then
         (match earned_income_amount with
          | Absent → error NoValue
          | Present arg → arg.0)
         * match credit_percentage with
           | Absent → error NoValue
           | Present arg → arg.0
         - (match income_over_phaseout with
            | Absent → error NoValue
            | Present arg → arg.0)
           * match phaseout_percentage with
             | Absent → error NoValue
             | Present arg → arg.0
       else ¤0.00, <section_32:72.5-76.12>)
  in
  let set credit : money =
    match
      Present
        (if
           match credit_before_limitation with
           | Absent → error NoValue
           | Present arg → arg.0
           ≥ match limitation with
             | Absent → error NoValue
             | Present arg → arg.0
         then
           match limitation with
           | Absent → error NoValue
           | Present arg → arg.0
         else
           match credit_before_limitation with
           | Absent → error NoValue
           | Present arg → arg.0, <section_32:79.5-81.34>)
    with
    | Absent → error NoValue
    | Present arg → arg.0
  in
  return { EarnedIncomeCredit credit = credit; }
